<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Conteneur des popups (fenêtre superposée type onglet) ; Retour la ferme -->
    <FrameLayout
        android:id="@+id/popupContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/cursor"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/cursor"
        android:visibility="gone"
        android:contentDescription="@null" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/bar_bg"
        android:scrollbars="none"
        android:fillViewport="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:gravity="center_vertical">

            <Button android:id="@+id/btnBack" style="@style/BarButton" android:text="Préc." />
            <Button android:id="@+id/btnFwd" style="@style/BarButton" android:text="Suiv." />
            <Button android:id="@+id/btnReload" style="@style/BarButton" android:text="↻" />
            <Button android:id="@+id/btnHome" style="@style/BarButton" android:text="Accueil" />
            <Button android:id="@+id/btnZoomOut" style="@style/BarButton" android:text="A−" />
            <Button android:id="@+id/btnZoomIn" style="@style/BarButton" android:text="A+" />

            <EditText
                android:id="@+id/url"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/url_bg"
                android:hint="@string/hint_url"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#88FFFFFF"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:textSize="15sp" />

            <Button android:id="@+id/btnAddFav" style="@style/BarButton" android:text="☆ Ajouter" />
            <Button android:id="@+id/btnFav" style="@style/BarButton" android:text="★ Favoris" />
            <Button android:id="@+id/btnUA" style="@style/BarButton" android:text="Vue: Auto" />
            <Button android:id="@+id/btnPopup" style="@style/BarButton" android:text="Popups: OFF" />
            <Button android:id="@+id/btnCursor" style="@style/BarButton" android:text="Curseur: ON" />
            <Button android:id="@+id/btnAd" style="@style/BarButton" android:text="Anti-pub: ON" />
            <Button android:id="@+id/btnExit" style="@style/BarButton" android:text="Quitter" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Panneau des favoris (superposé, navigable à la télécommande) -->
    <LinearLayout
        android:id="@+id/favOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#D9000000"
        android:padding="24dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="★ Mes favoris"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFavClose"
                style="@style/BarButton"
                android:text="Fermer ✕" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/favList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/favEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucun favori pour l'instant.\nOuvrez un site puis appuyez sur « ☆ Ajouter »."
            android:textColor="#B0C4D4"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingTop="40dp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
